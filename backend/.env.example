# Copy this file to backend/.env and fill it locally. Never commit backend/.env.
#
# The FastAPI runtime deliberately uses the caller's Supabase JWT plus this
# publishable key for PostgREST. It does not use a database password or a
# Supabase service-role key, so Row Level Security remains in force.

# Supabase Dashboard -> Project Settings -> API -> Project URL
JUSTDUMP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API -> Publishable key
JUSTDUMP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Supabase Dashboard -> Authentication -> Users -> copy the UUID for the one owner.
JUSTDUMP_OWNER_ID=00000000-0000-0000-0000-000000000000

# OpenAI API platform -> project-scoped API key. This is required only for the
# approved synthetic Milestone 3R experiment; never put it in Android.
OPENAI_API_KEY=replace_with_your_openai_api_key
